# AI Hub 环境配置模板
# 复制此文件为 .env 并填写实际值

# 服务器端口
PORT=3000

# JWT 密钥（必须更改为随机字符串！）
JWT_SECRET=change-this-to-a-random-string

# JWT 过期时间
JWT_EXPIRES_IN=7d

# 允许的跨域来源（生产环境设置具体域名，如 https://yourdomain.com）
CORS_ORIGIN=*

# 速率限制配置（毫秒）
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_MAX=3

# 环境标识 (development / production)
NODE_ENV=development

# =============== Vercel 部署配置 ===============

# Vercel Postgres 数据库连接（部署到 Vercel 时必须）
# 在 Vercel Dashboard -> Storage -> Postgres 创建数据库后获取
POSTGRES_URL=

# Vercel Blob 存储（用于头像和生成的图片）
# 在 Vercel Dashboard -> Storage -> Blob 创建后获取
BLOB_READ_WRITE_TOKEN=
