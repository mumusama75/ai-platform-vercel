{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node"
        }
    ],
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/server.js" },
        { "source": "/data/avatars/(.*)", "destination": "/server.js" },
        { "source": "/data/generated_images/(.*)", "destination": "/server.js" }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "X-XSS-Protection", "value": "1; mode=block" }
            ]
        }
    ]
}
